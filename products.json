---
layout: null
permalink: /products.json
---
[
  {% for product in site.data.products %}
  {
    "id": {{ product.id | jsonify }},
    "name": {{ product.name | jsonify }},
    "category": {{ product.category | jsonify }},
    "image": {{ product.image | jsonify }},
    "price": {{ product.price | jsonify }},
    "affiliate_link": {{ product.affiliate_link | jsonify }},
    "blurb": {{ product.blurb | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
