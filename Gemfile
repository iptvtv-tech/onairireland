source "https://rubygems.org"

gem "jekyll", "~> 3.9"
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-paginate"
  gem "jekyll-sitemap"
  gem "jekyll-seo-tag"
  gem "jekyll-feed"
  gem "jekyll-include-cache"
  gem "jekyll-archives"
end

gem "webrick", "~> 1.8" # needed for local `jekyll serve` on newer Ruby versions
